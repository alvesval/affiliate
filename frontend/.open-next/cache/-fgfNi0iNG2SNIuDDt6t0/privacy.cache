]],\"m\":\"$undefined\",\"G\":[\"$11\",[]],\"s\":false,\"S\":true}\n12:I[4431,[],\"OutletBoundary\"]\n14:I[5278,[],\"AsyncMetadataOutlet\"]\n16:I[4431,[],\"ViewportBoundary\"]\n18:I[4431,[],\"MetadataBoundary\"]\n19:\"$Sreact.suspense\"\n5:[\"$\",\"p\",null,{\"children\":\"Dados podem ser transmitidos às plataformas que o próprio usuário decidir conectar quando isso for necessário para executar uma ação solicitada, como autenticação ou publicação. Cada serviço de terceiro possui seus próprios termos e políticas.\"}]\n6:[\"$\",\"h2\",null,{\"children\":\"5. Retenção e exclusão\"}]\n7:[\"$\",\"p\",null,{\"children\":\"Conservamos dados enquanto necessários para prestar o serviço, cumprir obrigações aplicáveis ou manter a conta. O usuário pode desconectar integrações e solicitar exclusão de seus dados pela página de Exclusão de Dados.\"}]\n8:[\"$\",\"h2\",null,{\"children\":\"6. Segurança\"}]\n9:[\"$\",\"p\",null,{\"children\":\"Adotamos medidas técnicas e organizacionais proporcionais ao estágio e à natureza do serviço. Nenhum sistema conectado à internet pode garantir risco zero.\"}]\na:[\"$\",\"h2\",null,{\"children\":\"7. Direitos e contato\"}]\nb:[\"$\",\"p\",null,{\"children\":[\"Solicitações relacionadas a acesso, correção ou exclusão podem ser encaminhadas para \",[\"$\",\"a\",null,{\"href\":\"mailto:alvaldeir@gmail.com\",\"children\":\"alvaldeir@gmail.com\"}],\".\"]}]\nc:[\"$\",\"h2\",null,{\"children\":\"8. Alterações\"}]\nd:[\"$\",\"p\",null,{\"children\":\"Esta Política poderá ser atualizada à medida que o produto e suas integrações evoluírem. A data de atualização será indicada nesta página.\"}]\ne:[\"$\",\"footer\",null,{\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/terms\",\"children\":\"Termos de Uso\"}],[\"$\",\"$L4\",null,{\"href\":\"/data-deletion\",\"children\":\"Exclusão de Dados\"}]]}]\nf:[\"$\",\"$L12\",null,{\"children\":[\"$L13\",[\"$\",\"$L14\",null,{\"promise\":\"$@15\"}]]}]\n10:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L16\",null,{\"children\":\"$L17\"}],null],[\"$\",\"$L18\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$19\",null,{\"fallback\":null,\"children\":\"$L1a\"}]}]}]]}]\n17:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n13:null\n15:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Política de Privacidade | Affiliate Intelligence\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Crie, organize e publique campanhas de afiliados com mais inteligência.\"}]],\"error\":null,\"digest\":\"$undefined\"}\n1a:\"$15:metadata\"\n"}