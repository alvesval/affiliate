,{\"children\":\"5. Disponibilidade\"}]\n6:[\"$\",\"p\",null,{\"children\":\"O serviço está em evolução e pode sofrer alterações, manutenção ou indisponibilidade. Funcionalidades experimentais podem mudar antes de uma versão comercial definitiva.\"}]\n7:[\"$\",\"h2\",null,{\"children\":\"6. Propriedade intelectual\"}]\n8:[\"$\",\"p\",null,{\"children\":\"O software, identidade e componentes próprios do Affiliate Intelligence permanecem protegidos pelos direitos aplicáveis. Conteúdos e marcas de terceiros permanecem pertencentes aos respectivos titulares.\"}]\n9:[\"$\",\"h2\",null,{\"children\":\"7. Encerramento e exclusão\"}]\na:[\"$\",\"p\",null,{\"children\":\"O usuário pode deixar de utilizar o serviço, desconectar integrações e solicitar exclusão de dados conforme as instruções publicadas na página de Exclusão de Dados.\"}]\nb:[\"$\",\"h2\",null,{\"children\":\"8. Contato\"}]\nc:[\"$\",\"p\",null,{\"children\":[\"Dúvidas sobre estes Termos podem ser enviadas para \",[\"$\",\"a\",null,{\"href\":\"mailto:alvaldeir@gmail.com\",\"children\":\"alvaldeir@gmail.com\"}],\".\"]}]\nd:[\"$\",\"footer\",null,{\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/privacy\",\"children\":\"Política de Privacidade\"}],[\"$\",\"$L4\",null,{\"href\":\"/data-deletion\",\"children\":\"Exclusão de Dados\"}]]}]\ne:[\"$\",\"$L11\",null,{\"children\":[\"$L12\",[\"$\",\"$L13\",null,{\"promise\":\"$@14\"}]]}]\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L15\",null,{\"children\":\"$L16\"}],null],[\"$\",\"$L17\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$18\",null,{\"fallback\":null,\"children\":\"$L19\"}]}]}]]}]\n16:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n12:null\n14:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Termos de Uso | Affiliate Intelligence\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Crie, organize e publique campanhas de afiliados com mais inteligência.\"}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n"}