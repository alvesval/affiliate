# Copie para .env e NÃO envie .env ao Git nem ao ChatGPT
POSTGRES_DB=affiliate_intelligence
POSTGRES_USER=affiliate
POSTGRES_PASSWORD=affiliate_dev
DATABASE_URL=postgresql+psycopg://affiliate:affiliate_dev@db:5432/affiliate_intelligence
NEXT_PUBLIC_API_URL=http://localhost:8000
# Em produção use a URL HTTPS pública do backend (Railway), nunca localhost.
# Ex.: NEXT_PUBLIC_API_URL=https://seu-backend.up.railway.app
CORS_ORIGINS=https://iaaffintel.com,https://www.iaaffintel.com
JWT_SECRET=ALTERAR_EM_PRODUCAO
# Chave forte e exclusiva. Não reutilize a senha do banco.
ADMIN_SETUP_KEY=SUBSTITUIR_POR_CHAVE_ALEATORIA_FORTE
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Deve ser idêntico à URI HTTPS cadastrada no DevCenter.
MELI_REDIRECT_URI=
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# V1.5 - Social Publishing
FRONTEND_URL=http://localhost:3000
# TikTok Web Login Kit + Content Posting API (video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# HTTPS estático e idêntico ao cadastrado no TikTok for Developers
TIKTOK_REDIRECT_URI=
# Providers reservados para ativação OAuth oficial
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# V1.9 SaaS authentication - use a long random secret in production
JWT_SECRET=change-me-with-at-least-32-random-bytes

# V1.10 - Billing / Growth
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTRY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
PLATFORM_ADMIN_EMAILS=

# OpenAI Content Studio
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_VIDEO_MODEL=sora-2

# Stripe: use IDs price_... (não prod_...)
# STRIPE_SECRET_KEY=sk_test_... durante homologação
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook público: https://SEU_BACKEND/api/v1/billing/webhook

# V1.13.2 - Video Provider (fal.ai)
VIDEO_PROVIDER=fal
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/standard/text-to-video
# OPENAI_VIDEO_MODEL permanece apenas por compatibilidade com versões anteriores.

# V1.13.3 - Password recovery / transactional e-mail
# Crie a chave no provedor Resend e verifique o domínio iaaffintel.com antes de produção.
RESEND_API_KEY=
EMAIL_FROM=AIAffiliateIntelligence <noreply@iaaffintel.com>
PASSWORD_RESET_MINUTES=30
FAL_IMAGE_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video

# V1.15 RC - Pinterest OAuth / Video Pins
# Cadastre exatamente esta URL no app Pinterest:
# https://SEU_BACKEND/api/v1/social/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://SEU_BACKEND/api/v1/social/pinterest/callback

# Produção Stripe: use sk_live_..., whsec_... do endpoint LIVE e Price IDs LIVE.
# Nunca misture objetos test_ e live_. Faça primeiro uma assinatura real de baixo risco e valide webhook/portal/cancelamento.
